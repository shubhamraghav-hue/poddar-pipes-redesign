# Copy to .env.local for local development (never commit real values), and set
# the same names in the Vercel project's Environment Variables.

# --- Form delivery (app/api/enquiry, app/api/newsletter -> lib/forms/server.ts)
# Configure AT LEAST ONE channel. A submission is accepted if any configured
# channel succeeds. With none configured: development logs the submission and
# shows success ("simulated"); production answers 503 and the form tells the
# visitor to call or email instead.

# Channel 1 (recommended) — Google Sheet + email via Apps Script.
# Setup guide: integrations/google-sheets/README.md
SHEETS_WEBHOOK_URL=
SHEETS_WEBHOOK_SECRET=

# Channel 2 (optional) — Resend email.
# Resend API key (https://resend.com/api-keys) — "Sending access" is enough.
RESEND_API_KEY=
# Inbox(es) that receive submissions. Comma-separate several:
#   sales@poddarpipes.com,hello@poddarpipes.com
ENQUIRY_TO_EMAIL=
# Sender. Its domain must be verified in Resend (DNS records on poddarpipes.com).
# Visitors' replies go to the submitter via Reply-To, not to this address.
ENQUIRY_FROM_EMAIL="Poddar Pipes Website <website@poddarpipes.com>"

# --- Indexing (lib/seo.ts)
# Set to "production" ONLY in the real www.poddarpipes.com Vercel project.
# Anything else (previews, staging, local) stays noindex.
NEXT_PUBLIC_SITE_ENV=
